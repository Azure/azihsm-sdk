// Copyright (c) Microsoft Corporation.
//
// Uno SoC — top-level address map
//
// Memory map:
//   0x0000_0000  ITCM            512 KB  (code + vector table)
//   0x2000_0000  DTCM            256 KB  (stack + .bss, CPU-only)
//     0x2003_F400  hsm_dtcm_status (crashdump + core_run_status)  3 KB
//   0x6100_0000  SRAM              2 MB  (queues and DMA buffers; GSRAM region)
//     0x6100_7000  boot_handshake (BOOT_STATUS for Admin polling)  1 KB
//     0x6110_0000  io_gsram DTCM_IO_BUF (NonDma scratch)  64 KB
//   0x4000_2000  TraceMailbox      4 KB  (debug-only)
//   0xA000_0000  GDMA              4 KB  (azihsm-aligned)
//   0xA020_0000  AES               4 KB  (azihsm-aligned)
//   0xA030_0000  RNG               4 KB  (azihsm-aligned)
//   0xA040_0000  SHA               4 KB
//   0xA128_0000  IIC              16 KB  (azihsm-aligned; controller 0)
//   0xA12C_0000  OIC              16 KB  (azihsm-aligned; controller 0)
//   0xB000_6000  INTC            272 B   (IPC interrupt controller)
//   0xB000_9000  UART            4 KB    (debug console; silicon-only)
//   0xC000_0000  UPKA             64 KB  (16 PKA engines × 4 KB)
//   0xE000_0000  PPB (NVIC, SCB, SysTick, TCM)

`include "trace_mailbox.rdl"
`include "iic.rdl"
`include "oic.rdl"
`include "gdma.rdl"
`include "aes.rdl"
`include "sha.rdl"
`include "upka.rdl"
`include "rng.rdl"
`include "intc.rdl"
`include "uart.rdl"
`include "gsram_map.rdl"
`include "dtcm_map.rdl"

addrmap uno {
    name = "Uno SoC";
    desc = "Cortex-M7 SoC with 512KB ITCM, 256KB DTCM, 2MB SRAM,
             TraceMailbox, IIC, OIC, and GDMA peripherals.
             Upper 76KB of DTCM reserved for IO buffers and queues.
             No Flash — all code resides in ITCM.";

    default hw = na;
    default sw = rw;

    // Peripheral registers (MMIO) — azihsm-aligned bases
    trace_mailbox TRACE_MAILBOX @ 0x4000_2000;
    gdma   GDMA            @ 0xA000_0000;
    aes    AES             @ 0xA020_0000;
    rng    RNG             @ 0xA030_0000;
    sha    SHA             @ 0xA040_0000;
    iic    IIC             @ 0xA128_0000;
    oic    OIC             @ 0xA12C_0000;
    intc   INTC            @ 0xB000_6000;
    uart   UART            @ 0xB000_9000;
    upka   UPKA            @ 0xC000_0000;

    // IO buffers and queues — all in SRAM (GSRAM region)
    io_gsram IO_GSRAM       @ 0x6100_0000;

    // Boot handshake + core liveliness/crashdump regions (azihsm-aligned).
    // hsm_dtcm_status lives in DTCM (CPU-local); boot_handshake lives in GSRAM.
    boot_handshake  BOOT_HANDSHAKE   @ 0x6100_7000;
    hsm_dtcm_status HSM_DTCM_STATUS  @ 0x2003_F400;
};
